---
import { getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import LabNav from '../../../components/LabNav.astro';
import Quiz from '../../../ui/Quiz.svelte';
import { LOCALES, localePath, tf, useT, type Locale } from '../../../i18n';
import { LABS, type LabId } from '../../../shared/labs';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => LABS.map((lab) => ({ params: { lang, lab: lab.id } })));
}

const lang = Astro.params.lang as Locale;
const lab = Astro.params.lab as LabId;
const tr = useT(lang);
const entry = await getEntry('quiz', `${lang}/${lab}`);
if (!entry) throw new Error(`Missing quiz: ${lang}/${lab}`);
const { questions, bonus } = entry.data;
---

<Base lang={lang} title={`${tr('quiz.title')} · ${tr(`labs.${lab}.title`)}`} path={`${lab}/quiz`}>
  <div class="container narrow">
    <LabNav lang={lang} lab={lab} current="quiz" />
    <p class="intro">{tf(lang, 'quiz.intro', { total: questions.length })}</p>
    <Quiz client:load lang={lang} questions={questions} bonus={bonus} simUrl={localePath(lang, lab)} />
  </div>
</Base>

<style>
  .narrow {
    max-width: 46rem;
  }

  .intro {
    color: var(--ink-2);
  }
</style>
